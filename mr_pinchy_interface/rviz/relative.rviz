    - Alpha: 1
      Angular Arrow Scale: 0.10000000149011612
      Angular Color: 204; 204; 51
      Arrow Width: 0.5
      Class: rviz_default_plugins/TwistStamped
      Enabled: true
      Hide Small Values: false
      History Length: 1
      Linear Arrow Scale: 2
      Linear Color: 28; 113; 216
      Name: cmd_vel
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /mr_pinchy/cmd_vel
      Value: true
  Enabled: true
  Global Options:
    Background Color: 255; 255; 255
    Fixed Frame: mr_pinchy/base_link_ekf_flu
