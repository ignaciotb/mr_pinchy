        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /safety_filter/robot_marker
      Value: true
    - Alpha: 1
      Angular Arrow Scale: 0.10000000149011612
      Angular Color: 204; 204; 51
      Arrow Width: 0.5
      Class: rviz_default_plugins/TwistStamped
