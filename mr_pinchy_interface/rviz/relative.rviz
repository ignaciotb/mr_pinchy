Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /TF1/Frames1
      Splitter Ratio: 0.6
    Tree Height: 800
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz_common/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: sonar_filtered_pc
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: false
        mr_pinchy/base_link_ekf:
          Value: true
        mr_pinchy/base_link_ekf_flu:
          Value: true
        mr_pinchy/sonar_link_ekf:
          Value: true
      Marker Scale: 0.5
      Name: TF
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Update Interval: 0
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      Color: 0; 255; 0
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: false
      Name: sonar_raw_pc
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.01
      Style: Flat Squares
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 100
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /sonar_node/point_cloud
      Use Fixed Frame: true
      Value: false
    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      Color: 93; 247; 65
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: sonar_filtered_pc
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.02
      Style: Flat Squares
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /sonar_filter/point_cloud
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: robot_marker
      Namespaces:
        robot: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /safety_filter/robot_marker
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: obstacle_marker
      Namespaces:
        obstacle: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /safety_filter/obstacle_marker
      Value: true
    - Alpha: 1
      Angular Arrow Scale: 0.1
      Angular Color: 204; 204; 51
      Arrow Width: 0.5
      Class: rviz_default_plugins/TwistStamped
      Enabled: true
      Hide Small Values: true
      History Length: 1
      Linear Arrow Scale: 2
      Linear Color: 204; 51; 51
      Name: cmd_vel_ref
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /mr_pinchy/cmd_vel_ref
      Value: true
    - Alpha: 1
      Angular Arrow Scale: 0.1
      Angular Color: 204; 204; 51
      Arrow Width: 0.5
      Class: rviz_default_plugins/TwistStamped
      Enabled: true
      Hide Small Values: true
      History Length: 1
      Linear Arrow Scale: 2
      Linear Color: 28; 113; 216
      Name: cmd_vel
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /mr_pinchy/cmd_vel
      Value: true
  Enabled: true
  Global Options:
    Background Color: 255; 255; 255
    Fixed Frame: mr_pinchy/base_link_ekf_flu
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 6.0
      Focal Point:
        X: 1.0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.8
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz_default_plugins)
      Yaw: 4.19
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 1200
  Hide Left Dock: false
  Hide Right Dock: true
  Views:
    collapsed: true
  Width: 1600
  X: 0
  Y: 0
